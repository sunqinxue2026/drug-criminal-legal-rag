FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production

LLM_API_KEY=your_dashscope_api_key
LLM_MODEL=qwen-plus
LLM_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VISION_MODEL=qwen-vl-plus
LLM_ALLOWED_MODELS=qwen-turbo,qwen-plus,qwen-max

BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
BGE_PYTHON_EXE=D:\Program Files\Python\python.exe
BGE_ENABLE_BRIDGE=true

SPRINGBOOT_BASE_URL=http://localhost:8080/api
SPRINGBOOT_SERVICE_HEADER=X-Internal-Service-Token
SPRINGBOOT_SERVICE_TOKEN=change-me
HTTP_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
