<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gjq.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.gjq.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="image_url" property="imageUrl"/>
        <result column="image_name" property="imageName"/>
        <result column="create_time" property="createTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="countActiveMessages" resultType="long">
        SELECT COUNT(*)
        FROM chat_message
        WHERE deleted = 0
    </select>

    <select id="countMessagesByDaySince" resultType="com.gjq.dto.ChatDailyCountDTO">
        SELECT DATE_FORMAT(create_time, '%Y-%m-%d') AS day_key,
               COUNT(*) AS total
        FROM chat_message
        WHERE deleted = 0
          AND create_time <![CDATA[>=]]> #{start}
        GROUP BY DATE_FORMAT(create_time, '%Y-%m-%d')
        ORDER BY day_key ASC
    </select>

</mapper>
